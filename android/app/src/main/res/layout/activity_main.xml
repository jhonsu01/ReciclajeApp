<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="♻ Reciclaje Turnero"
            android:textColor="@color/verde"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/txtEstadoConexion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/gris"
            android:textSize="13sp"
            android:layout_marginBottom="16dp" />

        <!-- ============ VISTA 1: CONFIGURACIÓN ============ -->
        <LinearLayout
            android:id="@+id/vistaConfig"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/titulo_config"
                android:textColor="@color/texto"
                android:textSize="18sp"
                android:layout_marginBottom="14dp" />

            <EditText
                android:id="@+id/inputServidor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_servidor"
                android:inputType="text"
                android:textColor="@color/texto"
                android:textColorHint="@color/gris" />

            <EditText
                android:id="@+id/inputPuerto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_puerto"
                android:inputType="number"
                android:text="3000"
                android:textColor="@color/texto"
                android:textColorHint="@color/gris" />

            <EditText
                android:id="@+id/inputPin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_pin"
                android:inputType="numberPassword"
                android:textColor="@color/texto"
                android:textColorHint="@color/gris" />

            <Button
                android:id="@+id/btnConectar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/btn_conectar" />
        </LinearLayout>

        <!-- ============ VISTA 2: REGISTRO DE TURNO ============ -->
        <LinearLayout
            android:id="@+id/vistaRegistro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/titulo_registro"
                android:textColor="@color/texto"
                android:textSize="18sp"
                android:layout_marginBottom="14dp" />

            <Spinner
                android:id="@+id/spinnerTipoDoc"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/inputDocumento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_documento"
                android:inputType="text"
                android:textColor="@color/texto"
                android:textColorHint="@color/gris" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/material_opcional"
                android:textColor="@color/gris"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/spinnerMaterial"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <Button
                android:id="@+id/btnSolicitar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/btn_solicitar" />

            <Button
                android:id="@+id/btnCambiarServidor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/panel"
                android:textColor="@color/gris"
                android:text="@string/btn_cambiar_servidor" />
        </LinearLayout>

        <!-- ============ VISTA 3: TURNO ACTIVO ============ -->
        <LinearLayout
            android:id="@+id/vistaTurno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/titulo_turno"
                android:textColor="@color/gris"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/txtNumeroTurno"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/texto"
                android:textSize="72sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtEstadoTurno"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/txtModulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/amarillo"
                android:textSize="19sp"
                android:layout_marginBottom="16dp" />

            <ImageView
                android:id="@+id/imgQr"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_marginBottom="10dp"
                android:contentDescription="QR del turno" />

            <TextView
                android:id="@+id/txtPinTurno"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/gris"
                android:textSize="16sp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/txtRecibo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/panel"
                android:padding="14dp"
                android:textColor="@color/texto"
                android:textSize="14sp"
                android:visibility="gone"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnNuevoTurno"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_nuevo_turno"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
