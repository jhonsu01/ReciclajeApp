<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="♻ Reciclaje Turnero"
            android:textColor="@color/verde"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/txtEstadoConexion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/gris"
            android:textSize="13sp"
            android:layout_marginBottom="14dp" />

        <!-- ============ VISTA 0: SELECCIÓN DE ROL ============ -->
        <LinearLayout
            android:id="@+id/vistaRol"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/titulo_rol"
                android:textColor="@color/texto"
                android:textSize="18sp"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btnRolCliente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:paddingVertical="16dp"
                android:text="@string/rol_cliente" />

            <Button
                android:id="@+id/btnRolPesaje"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:paddingVertical="16dp"
                android:backgroundTint="@color/amarillo"
                android:textColor="@color/fondo"
                android:text="@string/rol_pesaje" />

            <Button
                android:id="@+id/btnRolAdmin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:paddingVertical="16dp"
                android:backgroundTint="@color/verde_oscuro"
                android:textColor="@color/texto"
                android:text="@string/rol_admin" />

            <Button
                android:id="@+id/btnRolInventario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:paddingVertical="16dp"
                android:backgroundTint="@color/verde_oscuro"
                android:textColor="@color/texto"
                android:text="@string/rol_inventario" />

            <Button
                android:id="@+id/btnRolKiosko"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="16dp"
                android:backgroundTint="@color/panel"
                android:textColor="@color/texto"
                android:text="@string/rol_kiosko" />

            <!-- Apoyo (Ko-fi) — solo visible en la app completa (Reciclaje Turnero) -->
            <LinearLayout
                android:id="@+id/seccionApoyo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginTop="28dp"
                android:visibility="gone">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/panel"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¿Te resulta útil este proyecto?"
                    android:textColor="@color/gris"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnKofi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="@color/verde"
                    android:textColor="@color/fondo"
                    android:text="☕ Apóyanos en Ko-fi" />

                <TextView
                    android:id="@+id/txtRepo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="github.com/jhonsu01/ReciclajeApp"
                    android:textColor="@color/gris"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============ VISTA 1: CONEXIÓN ============ -->
        <LinearLayout
            android:id="@+id/vistaConfig"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/titulo_config"
                android:textColor="@color/texto"
                android:textSize="18sp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/txtBusqueda"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/amarillo"
                android:textSize="14sp"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btnBuscar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:backgroundTint="@color/panel"
                android:textColor="@color/texto"
                android:text="@string/btn_buscar" />

            <EditText
                android:id="@+id/inputServidor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_servidor"
                android:inputType="text"
                android:textColor="@color/texto"
                android:textColorHint="@color/gris" />

            <EditText
                android:id="@+id/inputPuerto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_puerto"
                android:inputType="number"
                android:text="3000"
                android:textColor="@color/texto"
                android:textColorHint="@color/gris" />

            <EditText
                android:id="@+id/inputPin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_pin"
                android:inputType="numberPassword"
                android:textColor="@color/texto"
                android:textColorHint="@color/gris" />

            <Button
                android:id="@+id/btnConectar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/btn_conectar" />

            <Button
                android:id="@+id/btnVolverRol"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/panel"
                android:textColor="@color/gris"
                android:text="@string/btn_cambiar_rol" />
        </LinearLayout>

        <!-- ============ VISTA 2: REGISTRO (CLIENTE) ============ -->
        <LinearLayout
            android:id="@+id/vistaRegistro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/titulo_registro"
                android:textColor="@color/texto"
                android:textSize="18sp"
                android:layout_marginBottom="14dp" />

            <Spinner
                android:id="@+id/spinnerTipoDoc"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/inputDocumento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_documento"
                android:inputType="text"
                android:textColor="@color/texto"
                android:textColorHint="@color/gris" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/material_opcional"
                android:textColor="@color/gris"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/spinnerMaterial"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <Button
                android:id="@+id/btnSolicitar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/btn_solicitar" />

            <Button
                android:id="@+id/btnHistorial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/verde_oscuro"
                android:textColor="@color/texto"
                android:text="@string/btn_historial" />

            <Button
                android:id="@+id/btnCambiarServidor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/panel"
                android:textColor="@color/gris"
                android:text="@string/btn_cambiar_rol" />
        </LinearLayout>

        <!-- ============ VISTA 3: TURNO ACTIVO (CLIENTE) ============ -->
        <LinearLayout
            android:id="@+id/vistaTurno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/titulo_turno"
                android:textColor="@color/gris"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/txtNumeroTurno"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/texto"
                android:textSize="72sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtEstadoTurno"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/txtModulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/amarillo"
                android:textSize="19sp"
                android:layout_marginBottom="16dp" />

            <ImageView
                android:id="@+id/imgQr"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_marginBottom="10dp"
                android:contentDescription="QR del turno" />

            <TextView
                android:id="@+id/txtPinTurno"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/gris"
                android:textSize="16sp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/txtRecibo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/panel"
                android:padding="14dp"
                android:textColor="@color/texto"
                android:textSize="14sp"
                android:visibility="gone"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnNuevoTurno"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_nuevo_turno"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ============ VISTA 4: LISTA DE TURNOS (PESAJE) ============ -->
        <LinearLayout
            android:id="@+id/vistaPesaje"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/titulo_pesaje"
                android:textColor="@color/texto"
                android:textSize="18sp"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:id="@+id/listaTurnosPesaje"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <Button
                android:id="@+id/btnCambiarRolPesaje"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:backgroundTint="@color/panel"
                android:textColor="@color/gris"
                android:text="@string/btn_cambiar_rol" />
        </LinearLayout>

        <!-- ============ VISTA 5: DETALLE DE PESAJE ============ -->
        <LinearLayout
            android:id="@+id/vistaPesajeDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtPesajeTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/texto"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <Spinner
                android:id="@+id/spinnerMaterialPesaje"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/inputKg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Peso en kg (ej: 12.5)"
                android:inputType="numberDecimal"
                android:textColor="@color/texto"
                android:textColorHint="@color/gris" />

            <TextView
                android:id="@+id/txtValorEstimado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/verde"
                android:textSize="26sp"
                android:textStyle="bold"
                android:layout_marginVertical="10dp" />

            <Button
                android:id="@+id/btnAgregarPesaje"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/amarillo"
                android:textColor="@color/fondo"
                android:text="@string/btn_agregar_pesaje" />

            <TextView
                android:id="@+id/txtPesajesLista"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/panel"
                android:padding="12dp"
                android:layout_marginTop="12dp"
                android:textColor="@color/texto"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnFinalizarPesaje"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/btn_finalizar" />

            <Button
                android:id="@+id/btnVolverLista"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/panel"
                android:textColor="@color/gris"
                android:text="@string/btn_volver" />
        </LinearLayout>

        <!-- ============ VISTA 6: ADMINISTRADOR (PAGOS) ============ -->
        <LinearLayout
            android:id="@+id/vistaAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/titulo_admin"
                android:textColor="@color/texto"
                android:textSize="18sp"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:id="@+id/listaRecibos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <Button
                android:id="@+id/btnCambiarRolAdmin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:backgroundTint="@color/panel"
                android:textColor="@color/gris"
                android:text="@string/btn_cambiar_rol" />
        </LinearLayout>

        <!-- ============ VISTA 7: INVENTARIO ============ -->
        <LinearLayout
            android:id="@+id/vistaInventario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/titulo_inventario"
                android:textColor="@color/texto"
                android:textSize="18sp"
                android:layout_marginBottom="10dp" />

            <EditText
                android:id="@+id/inputBuscarInv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Buscar material…"
                android:inputType="text"
                android:textColor="@color/texto"
                android:textColorHint="@color/gris"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:id="@+id/listaInventario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <Button
                android:id="@+id/btnCambiarRolInventario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:backgroundTint="@color/panel"
                android:textColor="@color/gris"
                android:text="@string/btn_cambiar_rol" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
